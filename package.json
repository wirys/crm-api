{
  "name": "api",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "prisma:generate": "prisma generate",
    "build": "bun run prisma:generate && bun build ./src/index.ts --target=bun --outdir=./dist --minify --sourcemap",
    "build:bin": "bun run prisma:generate && bun build ./src/index.ts --compile --minify --sourcemap --outfile=./dist/server",
    "start": "NODE_ENV=production bun run ./dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.14",
    "@prisma/adapter-mssql": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@types/mssql": "^9.1.9",
    "@types/node": "^25.0.10",
    "dotenv": "^17.2.3",
    "elysia": "latest",
    "nodemailer": "^9.0.5",
    "prisma": "^7.3.0",
    "resend": "^6.19.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "bun-types": "latest"
  },
  "module": "src/index.js"
}
